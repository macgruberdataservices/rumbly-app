{
  "expo": {
    "name": "App",
    "slug": "App",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.macgruberdataservices.rumbly",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "mdx"
        ],
        "NSAppTransportSecurity": {
          "NSExceptionDomains": {
            "tailabf79a.ts.net": {
              "NSExceptionAllowsInsecureHTTPLoads": true,
              "NSIncludesSubdomains": true
            }
          }
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.macgruberdataservices.rumbly"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-font",
      "expo-splash-screen",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Rumbly to use your location while the app is open to show nearby dining options."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Rumbly to choose photos for your private Journal.",
          "cameraPermission": "Allow Rumbly to take photos for your private Journal.",
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Rumbly to choose photos for your private Journal.",
          "savePhotosPermission": "Allow Rumbly to save Journal camera photos to your photo library.",
          "granularPermissions": [
            "photo"
          ]
        }
      ]
    ]
  }
}
